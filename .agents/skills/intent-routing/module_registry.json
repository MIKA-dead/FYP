{
  "version": "1.1",
  "description": "Pluggable modules: semantic ids for planner; backend ids for run_module.",
  "modules": [
    {
      "id": "mld_generate",
      "name": "MLD Text→Joints",
      "owner_agent": "motion-coder",
      "inputs": ["mld_text", "length"],
      "parallel_safe": false,
      "revision_targets": ["motion"],
      "mock": false,
      "backend": true,
      "script": "scripts/backends/mld_generate.py",
      "env": "mld",
      "description": "Generate joints via Motion Latent Diffusion."
    },
    {
      "id": "mld_bridge",
      "name": "MLD→MotionsFix Bridge",
      "owner_agent": "motion-coder",
      "inputs": ["joints_npy"],
      "parallel_safe": false,
      "revision_targets": [],
      "mock": false,
      "backend": true,
      "script": "scripts/backends/mld_to_motionfix.py",
      "env": "mld",
      "description": "Fit MLD joints into MotionsFix source npy (+ face-front)."
    },
    {
      "id": "motionfix_semantic_edit",
      "name": "MotionsFix Semantic Edit",
      "owner_agent": "motion-coder",
      "inputs": ["motion_edit_plan", "source_npy_or_id"],
      "parallel_safe": false,
      "revision_targets": ["motion"],
      "mock": false,
      "backend": true,
      "script": "scripts/backends/motionfix_edit.py",
      "env": "motionfix",
      "description": "MotionsFix diffusion/SDEdit driven by Intent→MotionEditPlan."
    },
    {
      "id": "speed_edit",
      "name": "Speed Edit",
      "owner_agent": "motion-coder",
      "inputs": ["revision.ops[speed]", "constraints.speed_scale", "source_npy"],
      "parallel_safe": true,
      "revision_targets": ["speed"],
      "mock": false,
      "backend": true,
      "script": "scripts/backends/motionfix_edit.py",
      "env": "motionfix",
      "description": "Geometric root-speed retarget (edit_mode=speed); no semantic regen."
    },
    {
      "id": "sit_hold_postprocess",
      "name": "Sit Hold Postprocess",
      "owner_agent": "motion-coder",
      "inputs": ["edited_npy", "refine.forbid"],
      "parallel_safe": false,
      "revision_targets": ["motion"],
      "mock": false,
      "backend": true,
      "script": "scripts/backends/sit_hold_postprocess.py",
      "env": "motionfix",
      "description": "After MotionsFix: damp yaw, freeze limbs after pelvis contact (kill rebound/stretch)."
    },
    {
      "id": "timeline_postprocess",
      "name": "Timeline Phase Postprocess",
      "owner_agent": "motion-coder",
      "inputs": ["edited_npy", "refine.phase_speed", "refine.drop_phases"],
      "parallel_safe": false,
      "revision_targets": ["motion"],
      "mock": false,
      "backend": true,
      "script": "scripts/backends/timeline_postprocess.py",
      "env": "motionfix",
      "description": "Action-agnostic phase speed / drop for wave, walk, turn timelines."
    },
    {
      "id": "wave_walk_postprocess",
      "name": "Wave Walk Postprocess",
      "owner_agent": "motion-coder",
      "inputs": ["edited_npy", "primary_action"],
      "parallel_safe": false,
      "revision_targets": ["motion"],
      "mock": false,
      "backend": true,
      "script": "scripts/backends/wave_walk_postprocess.py",
      "env": "motionfix",
      "description": "Force forward travel, damp other arm, boost waving arm for walk+wave."
    },
    {
      "id": "quality_gate",
      "name": "Quality Gate",
      "owner_agent": "motion-tester",
      "inputs": ["edited_npy", "primary_action"],
      "parallel_safe": false,
      "revision_targets": [],
      "mock": false,
      "backend": true,
      "script": "scripts/session/quality_gate.py",
      "env": "motionfix",
      "description": "Hard/soft checks on edited joints; score for UI."
    },
    {
      "id": "motion_caption",
      "name": "Motion→Text Caption",
      "owner_agent": "motion-tester",
      "inputs": ["edited_npy", "quality_json"],
      "parallel_safe": true,
      "revision_targets": [],
      "mock": false,
      "backend": true,
      "script": "scripts/session/motion_caption.py",
      "env": "host",
      "description": "Automatic textual feedback (rule-based M2T; optional MOTION_CAPTION_CMD)."
    },
    {
      "id": "simmotion_edit",
      "name": "SimMotionEdit (optional)",
      "owner_agent": "motion-coder",
      "inputs": ["source_npy", "edit_text"],
      "parallel_safe": false,
      "revision_targets": ["motion"],
      "mock": false,
      "backend": true,
      "script": "scripts/backends/simmotion_edit.py",
      "env": "simmotion",
      "description": "Optional CVPR25 editor; requires third_party/SimMotionEdit + checkpoints."
    },
    {
      "id": "visualize",
      "name": "Motion Visualize",
      "owner_agent": "motion-coder",
      "inputs": ["npy", "out_gif"],
      "parallel_safe": true,
      "revision_targets": [],
      "mock": false,
      "backend": true,
      "script": "scripts/backends/visualize_motion.py",
      "env": "motionfix",
      "description": "Render skeleton preview GIF."
    },
    {
      "id": "mock",
      "name": "Mock No-Op",
      "owner_agent": "motion-coder",
      "inputs": [],
      "parallel_safe": true,
      "revision_targets": [],
      "mock": true,
      "backend": true,
      "description": "No-op for lock/stub semantic modules."
    },
    {
      "id": "bg_lock",
      "name": "Background Lock",
      "owner_agent": "motion-coder",
      "inputs": ["lock_background_to"],
      "parallel_safe": true,
      "revision_targets": [],
      "mock": true,
      "maps_to": ["mock"],
      "description": "Freeze background / distant scene to a reference image."
    },
    {
      "id": "camera_lock",
      "name": "Camera Lock",
      "owner_agent": "motion-coder",
      "inputs": ["camera.move", "camera.cut"],
      "parallel_safe": true,
      "revision_targets": [],
      "mock": true,
      "maps_to": ["mock"],
      "description": "Disable camera move and cuts."
    },
    {
      "id": "appearance_ref",
      "name": "Appearance Reference",
      "owner_agent": "motion-coder",
      "inputs": ["character.appearance_ref"],
      "parallel_safe": true,
      "revision_targets": ["texture"],
      "mock": true,
      "maps_to": ["mock"],
      "description": "Bind character look to a front/side reference image."
    },
    {
      "id": "texture_edit",
      "name": "Texture / Look Edit",
      "owner_agent": "motion-coder",
      "inputs": ["revision.ops[texture]"],
      "parallel_safe": true,
      "revision_targets": ["texture"],
      "mock": true,
      "maps_to": ["mock"],
      "description": "Adjust material, lighting look, face cleanliness without changing motion."
    },
    {
      "id": "locomotion_walk",
      "name": "Walk Locomotion",
      "owner_agent": "motion-coder",
      "inputs": ["timeline[walk_*]", "speed", "steps"],
      "humanml3d_class": "WALK",
      "parallel_safe": false,
      "revision_targets": ["motion", "speed"],
      "mock": false,
      "maps_to": ["mld_generate", "mld_bridge", "motionfix_semantic_edit"],
      "description": "Walk via MLD+bridge+edit (or MotionsFix native when plan says so)."
    },
    {
      "id": "locomotion_run",
      "name": "Run Locomotion",
      "owner_agent": "motion-coder",
      "inputs": ["timeline[run_*]"],
      "humanml3d_class": "RUN",
      "parallel_safe": false,
      "revision_targets": ["motion", "speed"],
      "mock": false,
      "maps_to": ["mld_generate", "mld_bridge", "motionfix_semantic_edit"],
      "description": "Running motion via MLD chain."
    },
    {
      "id": "action_jump",
      "name": "Jump Action",
      "owner_agent": "motion-coder",
      "inputs": ["timeline[jump_*]"],
      "humanml3d_class": "JUMP",
      "parallel_safe": false,
      "revision_targets": ["motion", "speed"],
      "mock": false,
      "maps_to": ["mld_generate", "mld_bridge", "motionfix_semantic_edit"],
      "description": "Jump motion (see T001 patterns)."
    },
    {
      "id": "action_turn",
      "name": "Turn Action",
      "owner_agent": "motion-coder",
      "inputs": ["timeline[turn_*]"],
      "humanml3d_class": "TURN",
      "parallel_safe": false,
      "revision_targets": ["motion"],
      "mock": false,
      "maps_to": ["motionfix_semantic_edit"],
      "description": "In-place or stepping turn (prefer MotionsFix native)."
    },
    {
      "id": "action_sit",
      "name": "Sit Action",
      "owner_agent": "motion-coder",
      "inputs": ["timeline[sit_*]"],
      "humanml3d_class": "SIT",
      "parallel_safe": false,
      "revision_targets": ["motion"],
      "mock": false,
      "maps_to": ["motionfix_semantic_edit"],
      "description": "Sit-down (large span → MotionsFix native edit)."
    },
    {
      "id": "idle_stand",
      "name": "Idle / Stand",
      "owner_agent": "motion-coder",
      "inputs": ["timeline[idle_stand]"],
      "humanml3d_class": "STAND",
      "parallel_safe": false,
      "revision_targets": ["motion", "key_pose"],
      "mock": true,
      "maps_to": ["motionfix_semantic_edit"],
      "description": "Standing idle with mild expression."
    },
    {
      "id": "hold_keypose",
      "name": "Hold Key Pose",
      "owner_agent": "motion-coder",
      "inputs": ["timeline[hold_pose]", "target_pose_ref", "hands"],
      "parallel_safe": false,
      "revision_targets": ["key_pose"],
      "mock": true,
      "maps_to": ["motionfix_semantic_edit"],
      "description": "Hold a key pose aligned to a reference image (e.g. N2)."
    },
    {
      "id": "ref_pose_align",
      "name": "Reference Pose Align",
      "owner_agent": "motion-coder",
      "inputs": ["target_pose_ref", "refs[pose|target_position]"],
      "parallel_safe": false,
      "revision_targets": ["key_pose", "motion"],
      "mock": true,
      "maps_to": ["motionfix_semantic_edit"],
      "description": "Align root/end pose to a reference frame/image."
    },
    {
      "id": "gesture_wave",
      "name": "Wave Gesture",
      "owner_agent": "motion-coder",
      "inputs": ["timeline.gesture"],
      "parallel_safe": true,
      "revision_targets": ["motion"],
      "mock": false,
      "maps_to": ["motionfix_semantic_edit"],
      "description": "Hand wave via MotionsFix (prefer native id)."
    },
    {
      "id": "gesture_bow",
      "name": "Bow Gesture",
      "owner_agent": "motion-coder",
      "inputs": ["timeline[bow]"],
      "parallel_safe": false,
      "revision_targets": ["motion"],
      "mock": true,
      "maps_to": ["motionfix_semantic_edit"],
      "description": "Bowing gesture."
    },
    {
      "id": "keypose_edit",
      "name": "Key Pose Edit",
      "owner_agent": "motion-coder",
      "inputs": ["revision.ops[key_pose]"],
      "parallel_safe": false,
      "revision_targets": ["key_pose"],
      "mock": true,
      "maps_to": ["motionfix_semantic_edit"],
      "description": "Adjust held pose / hand clasp to a reference."
    },
    {
      "id": "motion_edit",
      "name": "Motion Local Edit",
      "owner_agent": "motion-coder",
      "inputs": ["revision.ops[motion]"],
      "parallel_safe": false,
      "revision_targets": ["motion"],
      "mock": true,
      "maps_to": ["motionfix_semantic_edit"],
      "description": "Local motion tweak (gesture side, step count, path offset)."
    },
    {
      "id": "lip_sync_stub",
      "name": "Lip Sync Stub",
      "owner_agent": "motion-coder",
      "inputs": ["timeline[speak]", "speech", "character.lip"],
      "parallel_safe": true,
      "revision_targets": ["motion"],
      "mock": true,
      "maps_to": ["mock"],
      "description": "Mock lip-sync / mouth amplitude control for speech segments."
    },
    {
      "id": "speak_stub",
      "name": "Speech Stub",
      "owner_agent": "motion-documenter",
      "inputs": ["speech.lang", "speech.script_id", "speech.text"],
      "parallel_safe": true,
      "revision_targets": [],
      "mock": true,
      "maps_to": ["mock"],
      "description": "Attach script metadata (Cantonese etc.); TTS left to external pipeline."
    },
    {
      "id": "timeline_compose",
      "name": "Timeline Compose",
      "owner_agent": "motion-coder",
      "inputs": ["timeline"],
      "parallel_safe": false,
      "revision_targets": ["motion", "speed", "key_pose"],
      "mock": true,
      "maps_to": [],
      "description": "Stitch multi-segment actions into one clip (planned)."
    },
    {
      "id": "quality_check",
      "name": "Quality Check",
      "owner_agent": "motion-tester",
      "inputs": ["artifact", "intent"],
      "parallel_safe": false,
      "revision_targets": [],
      "mock": false,
      "maps_to": ["quality_gate"],
      "description": "Validate output via quality_gate backend."
    }
  ]
}
